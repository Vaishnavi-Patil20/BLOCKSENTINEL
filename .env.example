# BlockSentinel Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# BLOCKCHAIN PROVIDER (REQUIRED)
# ============================================
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here
ALCHEMY_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# ============================================
# DATABASES
# ============================================
DATABASE_URL=postgres://blocksentinel:blocksentinel@postgres:5432/blocksentinel?sslmode=disable
CLICKHOUSE_URL=clickhouse://default:@clickhouse:9000/blocksentinel
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=blocksentinel

# ============================================
# ML SERVICE
# ============================================
# Local VS Code default. Docker Compose can override this to http://ml-service:8000.
ML_SERVICE_URL=http://localhost:8000

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ============================================
# SECURITY
# ============================================
JWT_SECRET=change_this_to_a_random_256_bit_string
API_RATE_LIMIT=100

# ============================================
# OBSERVABILITY
# ============================================
LOG_LEVEL=info
METRICS_ENABLED=true

# ============================================
# RISK ENGINE
# ============================================
RISK_ALERT_THRESHOLD=60

# Vite frontend overrides (optional)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
